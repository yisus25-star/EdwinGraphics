# Copia este archivo a .env localmente. Nunca subas .env al repositorio.
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edwingraphics
DB_USER=postgres
DB_PASSWORD=replace_with_local_database_password
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10
UPLOAD_DIR=uploads
UPLOAD_BASE_URL=/uploads
UPLOAD_MAX_FILE_SIZE_MB=5
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_CURRENCY=COP
SHOPIFY_RESERVATION_MINUTES=30
SHOPIFY_MOCK=true

# Pagos: "shopify" mantiene el flujo actual; usar "wompi" para checkout Wompi.
PAYMENT_PROVIDER=shopify
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_ENVIRONMENT=sandbox
PUBLIC_BASE_URL=http://127.0.0.1:8080
# Porcentaje solo estimativo para el dashboard; configura la tarifa de tu contrato Wompi.
PAYMENT_ESTIMATED_FEE_PERCENT=0
