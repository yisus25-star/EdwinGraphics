# Copia este archivo a .env localmente. Nunca subas .env al repositorio.
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edwingraphics
DB_USER=postgres
DB_PASSWORD=replace_with_local_database_password
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10
UPLOAD_DIR=uploads
UPLOAD_BASE_URL=/uploads
UPLOAD_MAX_FILE_SIZE_MB=5
PAYMENT_RESERVATION_MINUTES=30

# Wompi Web Checkout: se activa al completar las credenciales del comercio.
PAYMENT_PROVIDER=wompi
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_ENVIRONMENT=sandbox
# URL pública del frontend (debe servir pago-resultado.html); en producción debe ser HTTPS.
PUBLIC_BASE_URL=http://127.0.0.1:8080
# Porcentaje solo estimativo para el dashboard; configura la tarifa de tu contrato Wompi.
PAYMENT_ESTIMATED_FEE_PERCENT=0
